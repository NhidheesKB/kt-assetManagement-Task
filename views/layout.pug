doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title ? title + ' - ' : ''}KT Telematic Asset Management
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm
      .container-fluid.px-4
        a.navbar-brand(href="/")
          i.bi.bi-hdd-network.me-2
          | KT Telematic - Asset Management
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navContent")
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navContent
          ul.navbar-nav.ms-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link(href="/stock" class=currentPath === '/stock' || currentPath === '/' ? 'active' : '')
                i.bi.bi-boxes.me-1
                | Stock View
            li.nav-item
              a.nav-link(href="/assets" class=currentPath && currentPath.startsWith('/assets') ? 'active' : '')
                i.bi.bi-laptop.me-1
                | Assets
            li.nav-item
              a.nav-link(href="/employees" class=currentPath && currentPath.startsWith('/employees') ? 'active' : '')
                i.bi.bi-people.me-1
                | Employees
            li.nav-item
              a.nav-link(href="/categories" class=currentPath && currentPath.startsWith('/categories') ? 'active' : '')
                i.bi.bi-tags.me-1
                | Categories
            li.nav-item
              a.nav-link(href="/branches" class=currentPath && currentPath.startsWith('/branches') ? 'active' : '')
                i.bi.bi-building.me-1
                | Branches

    .container-fluid.px-4.py-4
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js")
    script(src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js")
    block scripts
