extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h4.mb-0 Employee Master
    button.btn.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#addEmployeeModal")
      i.bi.bi-plus-lg.me-1
      | Add Employee

  .card.shadow-sm.mb-3
    .card-body.py-3
      form.row.g-2(method="GET" action="/employees")
        .col-md-4
          input.form-control.form-control-sm(type="text" name="search" value=search placeholder="Search name, email, code...")
        .col-md-3
          select.form-select.form-select-sm(name="status")
            option(value="") All Statuses
            option(value="ACTIVE" selected=selectedStatus === 'ACTIVE') Active
            option(value="INACTIVE" selected=selectedStatus === 'INACTIVE') Inactive
        .col-md-3
          select.form-select.form-select-sm(name="branchId")
            option(value="") All Branches
            each b in branches
              option(value=b.id selected=selectedBranch === b.id) #{b.name}
        .col-md-2.d-flex.gap-2
          button.btn.btn-sm.btn-primary.w-100(type="submit") Filter
          a.btn.btn-sm.btn-outline-secondary(href="/employees") Reset

  .card.shadow-sm
    .card-body
      .table-responsive
        table#employeesTable.table.table-striped.table-bordered.w-100
          thead.table-light
            tr
              th Code
              th Name
              th Email
              th Branch
              th Status
              th Actions
          tbody
            if employees.length === 0
              tr
                td.text-center.text-muted(colspan="6") No employees found
            else
              each emp in employees
                tr
                  td.fw-bold #{emp.employeeCode}
                  td #{emp.name}
                  td #{emp.email}
                  td #{emp.branch ? emp.branch.name : '-'}
                  td
                    if emp.status === 'ACTIVE'
                      span.badge.bg-success Active
                    else
                      span.badge.bg-secondary Inactive
                  td.text-center
                    .btn-group.btn-group-sm
                      button.btn.btn-outline-primary(type="button" onclick=`openEditModal('${emp.id}', '${emp.name}', '${emp.email}', '${emp.branchId}', '${emp.status}')` title="Edit")
                        i.bi.bi-pencil
                      button.btn.btn-outline-danger(type="button" onclick=`deleteEmployee('${emp.id}', '${emp.name}')` title="Delete")
                        i.bi.bi-trash

      if meta
        .d-flex.justify-content-between.align-items-center.mt-3.pt-2.border-top
          .text-muted.small
            | Showing #{meta.total === 0 ? 0 : ((meta.page - 1) * meta.limit) + 1} to #{((meta.page - 1) * meta.limit) + employees.length} of #{meta.total} records (Page #{meta.page} of #{meta.totalPages || 1})
          ul.pagination.pagination-sm.mb-0
            li.page-item(class=meta.page <= 1 ? 'disabled' : '')
              a.page-link(href=meta.page <= 1 ? '#' : `?page=${meta.page - 1}&search=${encodeURIComponent(search || '')}&status=${selectedStatus || ''}&branchId=${selectedBranch || ''}`) Previous
            - for (let p = 1; p <= (meta.totalPages || 1); p++)
              li.page-item(class=meta.page === p ? 'active' : '')
                a.page-link(href=`?page=${p}&search=${encodeURIComponent(search || '')}&status=${selectedStatus || ''}&branchId=${selectedBranch || ''}`) #{p}
            li.page-item(class=meta.page >= meta.totalPages || meta.totalPages <= 1 ? 'disabled' : '')
              a.page-link(href=meta.page >= meta.totalPages ? '#' : `?page=${meta.page + 1}&search=${encodeURIComponent(search || '')}&status=${selectedStatus || ''}&branchId=${selectedBranch || ''}`) Next

  #addEmployeeModal.modal.fade(tabindex="-1")
    .modal-dialog
      .modal-content
        form#addEmployeeForm
          .modal-header
            h5.modal-title Add Employee
            button.btn-close(type="button" data-bs-dismiss="modal")
          .modal-body.row.g-3
            .col-12
              label.form-label Name
              input.form-control(type="text" name="name" required)
            .col-12
              label.form-label Email
              input.form-control(type="email" name="email" required)
            .col-12
              label.form-label Branch
              select.form-select(name="branchId" required)
                option(value="") Select Branch
                each b in branches
                  option(value=b.id) #{b.name}
            .col-12
              label.form-label Status
              select.form-select(name="status")
                option(value="ACTIVE" selected) Active
                option(value="INACTIVE") Inactive
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
            button.btn.btn-primary(type="submit") Save

  #editEmployeeModal.modal.fade(tabindex="-1")
    .modal-dialog
      .modal-content
        form#editEmployeeForm
          input#editEmpId(type="hidden")
          .modal-header
            h5.modal-title Edit Employee
            button.btn-close(type="button" data-bs-dismiss="modal")
          .modal-body.row.g-3
            .col-12
              label.form-label Name
              input#editEmpName.form-control(type="text" name="name" required)
            .col-12
              label.form-label Email
              input#editEmpEmail.form-control(type="email" name="email" required)
            .col-12
              label.form-label Branch
              select#editEmpBranchId.form-select(name="branchId" required)
                each b in branches
                  option(value=b.id) #{b.name}
            .col-12
              label.form-label Status
              select#editEmpStatus.form-select(name="status")
                option(value="ACTIVE") Active
                option(value="INACTIVE") Inactive
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
            button.btn.btn-primary(type="submit") Update

block scripts
  script.
    document.addEventListener('DOMContentLoaded', () => {
      new DataTable('#employeesTable', {
        paging: false,
        searching: false,
        info: false,
        order: []
      });
    });

    function openEditModal(id, name, email, branchId, status) {
      document.getElementById('editEmpId').value = id;
      document.getElementById('editEmpName').value = name;
      document.getElementById('editEmpEmail').value = email;
      document.getElementById('editEmpBranchId').value = branchId;
      document.getElementById('editEmpStatus').value = status;
      new bootstrap.Modal(document.getElementById('editEmployeeModal')).show();
    }

    async function deleteEmployee(id, name) {
      if (!confirm(`Are you sure you want to delete employee ${name}?`)) return;
      try {
        const res = await fetch(`/api/employees/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (!res.ok) throw new Error(json.message || 'Error deleting employee');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    document.getElementById('addEmployeeForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = {
        name: form.name.value,
        email: form.email.value,
        branchId: form.branchId.value,
        status: form.status.value
      };

      try {
        const res = await fetch('/api/employees', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.message || 'Error creating employee');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    });

    document.getElementById('editEmployeeForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('editEmpId').value;
      const data = {
        name: document.getElementById('editEmpName').value,
        email: document.getElementById('editEmpEmail').value,
        branchId: document.getElementById('editEmpBranchId').value,
        status: document.getElementById('editEmpStatus').value
      };

      try {
        const res = await fetch(`/api/employees/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (!res.ok) throw new Error(json.message || 'Error updating employee');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    });
